<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Curator.MainPage"
    Title="Curator">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="16">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto">

            <Label
                Text="Collections"
                FontSize="32"
                FontAttributes="Bold"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="☰"
                FontSize="24"
                WidthRequest="52"
                HeightRequest="52" />

        </Grid>

        <!-- Search and view selector -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">

            <SearchBar
                Placeholder="Search collections" />

            <Button
                Grid.Column="1"
                Text="▦"
                WidthRequest="52"
                HeightRequest="52" />

        </Grid>

        <!-- Temporary collection cards -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="12"
            RowSpacing="12">

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Padding="16"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Books"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="Collection"
                        FontSize="16"
                        HorizontalOptions="Center" />

                    <Label
                        Text="0 items"
                        FontSize="12"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Border>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Padding="16"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Games"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="Collection"
                        FontSize="16"
                        HorizontalOptions="Center" />

                    <Label
                        Text="0 items"
                        FontSize="12"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Border>

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Padding="16"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Movies"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="Collection"
                        FontSize="16"
                        HorizontalOptions="Center" />

                    <Label
                        Text="0 items"
                        FontSize="12"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Border>

        </Grid>

        <!-- Add button -->
        <Button
            Grid.Row="3"
            Text="+"
            FontSize="28"
            WidthRequest="64"
            HeightRequest="64"
            HorizontalOptions="End" />

    </Grid>

</ContentPage>
