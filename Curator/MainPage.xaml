<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Curator.MainPage"
    Title="Curator">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="16">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto">

            <Label
                x:Name="HeaderLabel"
                Text="{Binding CurrentLocation}"
                FontSize="32"
                FontAttributes="Bold"
                VerticalOptions="Center" >

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                    Tapped="BackToRootClicked" />
                </Label.GestureRecognizers>
            </Label>

            <Button
                Grid.Column="1"
                Text="☰"
                FontSize="24"
                WidthRequest="52"
                HeightRequest="52" />

        </Grid>

        <!-- Search and view selector -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">

            <SearchBar
                Placeholder="Search collections" />

            <Button
                Grid.Column="1"
                Text="▦"
                WidthRequest="52"
                HeightRequest="52" />

        </Grid>

        <!--Collection Cards -->
        <!--<Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="12"
            RowSpacing="12">

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Padding="16"
                StrokeThickness="1">-->

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding Library}">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            Orientation="Vertical"
                            Span="2"
                            HorizontalItemSpacing="12"
                            VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="CollectionCard"
                                Padding="16"
                                StrokeThickness="1">
                                <Border.Behaviors>
                                    
                                    <toolkit:TouchBehavior
                                        LongPressDuration="750"
                                        LongPressCommandParameter="{Binding BindingContext, Source={x:Reference CollectionCard}}"
                                        LongPressCompleted="OnCollectionLongPressed"  />
                                </Border.Behaviors>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OpenFolderCollectionClicked"
                                        CommandParameter="{Binding BindingContext, Source={x:Reference CollectionCard}}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="8">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="20"
                                        FontAttributes="Bold" />

                                    <Label
                                        Text="{Binding CollectionType}"
                                        FontSize="16"
                                        HorizontalOptions="Center" />

                                    <Label
                                        Text="{Binding ItemCount, StringFormat='{0} items'}"
                                        FontSize="12"
                                        HorizontalOptions="Center" />

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

        <!--</Border>

        </Grid>-->

        <!-- Add button -->
        <Button
            Grid.Row="3"
            Text="+"
            FontSize="28"
            WidthRequest="64"
            HeightRequest="64"
            HorizontalOptions="End" 
            Clicked="OnAddCollectionClicked" />

    </Grid>

</ContentPage>
